# =============================================================================
# HydroVision — Variables de entorno
# =============================================================================
# Copiar este archivo como `.env` para desarrollo local:
#   copy .env.example .env   (Windows)
#   cp .env.example .env     (macOS/Linux)
#
# Sprint 3A: Prisma requiere DATABASE_URL (aunque DATA_SOURCE=mock).
# NUNCA commitear `.env` con credenciales reales al repositorio.
# =============================================================================

# -----------------------------------------------------------------------------
# Base de datos PostgreSQL (Sprint 3A+)
# -----------------------------------------------------------------------------
# Formato: postgresql://USUARIO:CONTRASEÑA@HOST:PUERTO/NOMBRE_BD?schema=public
# Cliente singleton: src/server/db/client.ts
# Documentación: docs/DATABASE.md
DATABASE_URL="postgresql://hydrovision:CAMBIAR_PASSWORD@localhost:5432/hydrovision?schema=public"

# Base de datos sombra para migraciones Prisma (opcional, entornos cloud)
# SHADOW_DATABASE_URL="postgresql://hydrovision:CAMBIAR_PASSWORD@localhost:5432/hydrovision_shadow?schema=public"

# -----------------------------------------------------------------------------
# Origen de datos — Fase 4.6 (Provider Pattern)
# -----------------------------------------------------------------------------
# Valores: mock | database | gee | api
# mock     = datos simulados centralizados (desarrollo sin PostgreSQL)
# database = PostgreSQL via Prisma (recomendado para integración — requiere migrate + seed)
# gee      = Google Earth Engine (Fase 5+, stub hasta conectar)
# api      = APIs externas (Fase 5+, stub hasta conectar)
DATA_SOURCE="database"
# Alternativa expuesta al cliente Next.js (opcional):
# NEXT_PUBLIC_DATA_SOURCE="database"

# Compatibilidad legacy — USE_DATABASE=true equivale a DATA_SOURCE=database
USE_DATABASE="true"

# -----------------------------------------------------------------------------
# Módulo Estaciones — Sprint 3B
# -----------------------------------------------------------------------------
# mock     = estaciones desde mockDataStore (sin PostgreSQL)
# database = estaciones desde PostgreSQL (default cuando DATA_SOURCE=database)
STATIONS_DATA_SOURCE="database"

# -----------------------------------------------------------------------------
# Aplicación
# -----------------------------------------------------------------------------
NODE_ENV="development"

# Zona horaria para consultas y reportes
TZ="America/Lima"

# -----------------------------------------------------------------------------
# Autenticación (ver docs/AUTHORIZATION.md)
# -----------------------------------------------------------------------------
# Secreto de firma de la cookie de sesión: ≥ 32 caracteres aleatorios. OBLIGATORIO fuera de
# desarrollo (sin él no hay sesiones). Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# AUTH_SECRET=""
# AUTH_SESSION_TTL_HOURS="8"
# AUTH_BCRYPT_ROUNDS="12"

# Primer ADMIN (npm run seed:admin). Nunca deje la contraseña en el código ni la suba al repo.
# HV_ADMIN_EMAIL=""
# HV_ADMIN_PASSWORD=""
# HV_ADMIN_NAME="Administrador"
# HV_ADMIN_INSTITUTION="HydroVision"
# HV_ADMIN_RESET="false"

# Usuario SIMULADO — solo funciona con NODE_ENV="development" (bloqueado en cualquier otro):
#   usr-admin | usr-investigador | usr-operador | usr-visor | usr-inactivo
DEV_SIMULATED_USER_ID="usr-admin"
# Alternativa por request HTTP: header X-HydroVision-Dev-User

# -----------------------------------------------------------------------------
# Google Earth Engine — Sprint 2 (Service Account, sin consumo real aún)
# -----------------------------------------------------------------------------
# Correo de la cuenta de servicio (client_email del JSON)
# GOOGLE_CLIENT_EMAIL="gee-sa@your-project.iam.gserviceaccount.com"
#
# Clave privada PEM (usar comillas y reemplazar saltos de línea por \n)
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
#
# ID del proyecto Google Cloud
# GOOGLE_PROJECT_ID="your-gcp-project-id"
#
# ID del proyecto con Earth Engine habilitado
# GOOGLE_EARTH_ENGINE_PROJECT="your-gee-project-id"
#
# Opcional: deshabilitar integración GEE
# GEE_INTEGRATION_ENABLED="true"
#
# Consulta Sentinel-2 vía GEE en APIs satelitales:
# GET /api/satellite/scenes?stationId=est-e01&useGee=true
# GET /api/satellite/observations?stationId=est-e01&useGee=true
#
# Legacy (opcional):
# GOOGLE_SERVICE_ACCOUNT="path/to/service-account.json"

# -----------------------------------------------------------------------------
# Copernicus Data Space Ecosystem (CDSE) — Sentinel-2 vía OAuth client_credentials
# -----------------------------------------------------------------------------
# 1. Crear cuenta gratuita en https://dataspace.copernicus.eu/
# 2. Registrar una aplicación OAuth en https://shapps.dataspace.copernicus.eu/dashboard/
#    (Settings → OAuth clients → Create) para obtener client_id/client_secret.
# 3. Pegar aquí SIN comillas de más ni saltos de línea:
#
# COPERNICUS_CLIENT_ID="tu-client-id"
# COPERNICUS_CLIENT_SECRET="tu-client-secret"
#
# Opcional: deshabilitar integración Copernicus
# COPERNICUS_INTEGRATION_ENABLED="true"
#
# Consulta Sentinel-2 vía Copernicus en APIs satelitales (prioridad sobre useGee):
# GET /api/satellite/scenes?stationId=est-e01&useCopernicus=true
# GET /api/satellite/observations?stationId=est-e01&useCopernicus=true
# GET /api/satellite/prediction?stationId=est-e01&parameterCode=turbidity&useCopernicus=true
#
# Endpoints: Catalog API (búsqueda STAC) https://sh.dataspace.copernicus.eu/api/v1/catalog/1.0.0/search
#            Process API (bandas)        https://sh.dataspace.copernicus.eu/api/v1/process
#            Identity/token              https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token
# Sin estas variables, el adaptador Copernicus opera en modo simulado (meta.isSimulated=true).

# -----------------------------------------------------------------------------
# Proveedor Sentinel-2 por defecto (ver docs/SATELLITE_PROVIDER.md)
# -----------------------------------------------------------------------------
# planetary (por defecto) | copernicus
# SATELLITE_PRIMARY_PROVIDER="planetary"
# Respaldo automático al otro proveedor si el principal no responde (por defecto: true).
# El respaldo de Copernicus solo se activa con COPERNICUS_CLIENT_ID/COPERNICUS_CLIENT_SECRET.
# SATELLITE_PROVIDER_FALLBACK="true"
# Microsoft Planetary Computer no requiere credenciales; desactivar con:
# PLANETARY_COMPUTER_ENABLED="false"
# Control de carga hacia Planetary Computer (evita su límite de peticiones):
# PLANETARY_MAX_CONCURRENCY="3"          # 2–4 solicitudes simultáneas
# PLANETARY_MAX_RETRIES="3"              # reintentos ante 429 / 5xx
# PLANETARY_RETRY_BASE_DELAY_MS="500"    # se duplica en cada reintento
# PLANETARY_RETRY_MAX_DELAY_MS="8000"
# PLANETARY_STAC_CACHE_TTL_SECONDS="600" # caché de búsquedas STAC repetidas
# PLANETARY_STAC_CACHE_MAX_ENTRIES="100"
# Selección del píxel de agua: radio máximo de ajuste al agua más cercana (0–60 m).
# Ver docs/WATER_PIXEL_SELECTION.md
# WATER_PIXEL_SEARCH_RADIUS_M="30"
# Regla de nubes en la ventana 3×3: strict (por defecto) | relaxed (costero: ≤ 1 píxel contaminado)
# WATER_PIXEL_CLOUD_MODE="strict"
# Escenas que evalúa el buscador de tramos aptos (1–12)
# TRAMO_FINDER_SCENES="6"
# Tamaño máximo de GeoJSON subidos (bytes)
# GEOJSON_MAX_BYTES="1000000"
# Directorio de datos locales (reportes guardados, geometrías, imágenes propias)
# HV_DATA_DIR=".hv-data"
# Imágenes propias (dron / campo): tamaño máximo de archivo (bytes)
# OWN_IMAGE_MAX_BYTES="50000000"

# -----------------------------------------------------------------------------
# Inteligencia Artificial (Fase 6 — no configurar aún)
# -----------------------------------------------------------------------------
# AI_SERVICE_URL="http://localhost:8000"
# AI_MODEL_VERSION="hv-risk-v1.0"
