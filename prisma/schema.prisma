// =============================================================================
// HydroVision — PostgreSQL + Prisma (Sprint 3A–3D)
// =============================================================================
// Modelos núcleo (API Prisma en inglés · tablas PostgreSQL en español via @@map):
//   Watershed · River · Station · Campaign · Parameter · Measurement
//   SatelliteIndex · EnvironmentalAssessment
//
// Extensiones v2: geografía admin, subcuencas, normativa ECA, proyectos,
//   imágenes satelitales, usuarios y reportes.
//
// Runtime UI: mock activo (DATA_SOURCE=mock). PostgreSQL preparado, no conectado.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// ENUMS
// =============================================================================

enum EstadoRegistro {
  active   @map("active")
  inactive @map("inactive")
  archived @map("archived")
}

enum EstadoECA {
  compliant     @map("compliant")
  alert         @map("alert")
  non_compliant @map("non_compliant")
}

enum EstadoPuntoMonitoreo {
  active      @map("active")
  maintenance @map("maintenance")
  offline     @map("offline")
}

enum EstadoCampana {
  planned   @map("planned")
  active    @map("active")
  completed @map("completed")
  cancelled @map("cancelled")
}

enum EstadoMuestreo {
  registered @map("registered")
  validated  @map("validated")
  rejected   @map("rejected")
}

enum EstadoProyecto {
  planned   @map("planned")
  active    @map("active")
  completed @map("completed")
  archived  @map("archived")
}

enum EstadoNormativa {
  draft  @map("draft")
  active @map("active")
  revoked @map("revoked")
}

enum EstadoReporte {
  draft     @map("draft")
  generated @map("generated")
  published @map("published")
  archived  @map("archived")
}

enum RolUsuario {
  admin          @map("admin")
  researcher     @map("researcher")
  field_operator @map("field_operator")
  viewer         @map("viewer")
}

enum FuenteSatelital {
  landsat8  @map("landsat8")
  landsat9  @map("landsat9")
  sentinel2 @map("sentinel2")
}

enum NivelAlerta {
  low      @map("low")
  medium   @map("medium")
  high     @map("high")
  critical @map("critical")
}

enum TipoCuerpoAgua {
  river     @map("river")
  stream    @map("stream")
  canal     @map("canal")
  reservoir @map("reservoir")
  lagoon    @map("lagoon")
}

enum TipoParametroCodigo {
  ph                     @map("ph")
  turbidity              @map("turbidity")
  conductivity           @map("conductivity")
  dissolved_oxygen       @map("dissolved_oxygen")
  temperature            @map("temperature")
  bod5                   @map("bod5")
  cod                    @map("cod")
  coliforms              @map("coliforms")
  nitrates               @map("nitrates")   // Sprint 2A — Nitratos
  phosphates             @map("phosphates") // Sprint 2A — Fosfatos
  total_dissolved_solids @map("total_dissolved_solids")
  flow_rate              @map("flow_rate")
}

enum CalidadDato {
  valid     @map("valid")
  estimated @map("estimated")
  suspect   @map("suspect")
}

enum NivelConfianza {
  high      @map("high")
  medium    @map("medium")
  low       @map("low")
  estimated @map("estimated")
}

enum TipoEstacion {
  automatica @map("automatica")
  manual     @map("manual")
  mixta      @map("mixta")
  referencia @map("referencia")
}

// =============================================================================
// CATÁLOGOS AMBIENTALES — Sprint 3D
// =============================================================================

model Department {
  id            String         @id
  codigo        String         @unique @db.VarChar(10)
  nombre        String         @db.VarChar(120)
  estado        EstadoRegistro @default(active)
  observaciones String?        @db.Text
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  provinces Province[]
  stations  Station[]

  @@index([estado])
  @@map("departamentos")
}

model Province {
  id           String         @id
  departmentId String         @map("departamento_id")
  nombre       String         @db.VarChar(120)
  estado       EstadoRegistro @default(active)
  observaciones String?       @db.Text
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  districts  District[]
  stations   Station[]

  @@index([departmentId])
  @@index([estado])
  @@map("provincias")
}

model District {
  id          String         @id
  provinceId  String         @map("provincia_id")
  nombre      String         @db.VarChar(120)
  estado      EstadoRegistro @default(active)
  observaciones String?      @db.Text
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  province  Province    @relation(fields: [provinceId], references: [id], onDelete: Restrict)
  watersheds Watershed[]
  stations  Station[]

  @@index([provinceId])
  @@index([estado])
  @@map("distritos")
}

model WaterBodyType {
  id            String         @id
  codigo        String         @unique @db.VarChar(30)
  nombre        String         @db.VarChar(120)
  descripcion   String?        @db.Text
  estado        EstadoRegistro @default(active)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  stations Station[]

  @@index([estado])
  @@map("cat_tipos_cuerpo_agua")
}

model ParameterCategory {
  id            String         @id
  codigo        String         @unique @db.VarChar(30)
  nombre        String         @db.VarChar(120)
  descripcion   String?        @db.Text
  estado        EstadoRegistro @default(active)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  parameters Parameter[]

  @@index([estado])
  @@map("cat_categorias_parametro")
}

model MeasurementUnit {
  id            String         @id
  codigo        String         @unique @db.VarChar(30)
  simbolo       String         @db.VarChar(20)
  nombre        String         @db.VarChar(120)
  descripcion   String?        @db.Text
  estado        EstadoRegistro @default(active)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  parameters  Parameter[]
  measurements Measurement[]

  @@index([estado])
  @@map("cat_unidades_medicion")
}

model EcaStandard {
  id            String          @id
  codigo        String          @unique @db.VarChar(30)
  nombre        String          @db.VarChar(200)
  descripcion   String          @db.Text
  version       String          @db.VarChar(20)
  vigenteDesde  DateTime        @map("vigente_desde") @db.Date
  vigenteHasta  DateTime?       @map("vigente_hasta") @db.Date
  estado        EstadoNormativa @default(active)
  observaciones String?         @db.Text
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  parameterLimits EcaStandardParameterLimit[]
  assessments     EnvironmentalAssessment[]
  campaigns       Campaign[]

  @@index([estado])
  @@index([vigenteDesde, vigenteHasta])
  @@map("normativas_eca")
}

model EcaStandardParameterLimit {
  id            String   @id
  ecaStandardId String   @map("normativa_id")
  parametroId   String   @map("parametro_id")
  limiteMin     Float?   @map("limite_min")
  limiteMax     Float?   @map("limite_max")
  unidad        String   @db.VarChar(30)
  observaciones String?  @db.Text
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  ecaStandard EcaStandard @relation(fields: [ecaStandardId], references: [id], onDelete: Cascade)
  parameter   Parameter   @relation(fields: [parametroId], references: [id], onDelete: Restrict)

  @@unique([ecaStandardId, parametroId])
  @@index([parametroId])
  @@map("normativa_limites_parametro")
}

model SatelliteSource {
  id               String         @id
  codigo           String         @unique @db.VarChar(30)
  nombre           String         @db.VarChar(120)
  plataforma       String         @db.VarChar(80)
  resolucionMetros Float?         @map("resolucion_m")
  descripcion      String?        @db.Text
  estado           EstadoRegistro @default(active)
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  satelliteIndices SatelliteIndex[]

  @@index([estado])
  @@index([plataforma])
  @@map("cat_fuentes_satelitales")
}

model SensorType {
  id            String         @id
  codigo        String         @unique @db.VarChar(30)
  nombre        String         @db.VarChar(120)
  tecnologia    String         @db.VarChar(80)
  descripcion   String?        @db.Text
  estado        EstadoRegistro @default(active)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  stations Station[]

  @@index([estado])
  @@index([tecnologia])
  @@map("cat_tipos_sensor")
}

// =============================================================================
// HIDROGRAFÍA — Watershed → Subcuenca → Río / Quebrada → Punto de Monitoreo
// =============================================================================

// =============================================================================
// 1. CUENCA HIDROGRÁFICA — Sprint 2A
// id · nombre · región · país · descripción (+ vínculo administrativo v2)
// =============================================================================

model Watershed {
  id            String         @id
  codigo        String         @unique @db.VarChar(20)
  distritoId    String         @map("distrito_id")
  nombre        String         @db.VarChar(150)
  /// Región geográfica de estudio (ej. Lambayeque)
  region        String         @default("Lambayeque") @db.VarChar(120)
  /// País del área de monitoreo
  pais          String         @default("Perú") @db.VarChar(80)
  /// Descripción científica de la cuenca hidrográfica
  descripcion   String?        @db.Text
  areaKm2       Float          @map("area_km2")
  estado        EstadoRegistro @default(active)
  observaciones String?        @db.Text
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  distrito        District         @relation(fields: [distritoId], references: [id], onDelete: Restrict)
  subcuencas      Subcuenca[]
  rios            River[]
  quebradas       Quebrada[]
  puntosMonitoreo Station[]
  campanas        Campaign[]
  reportes        Reporte[]
  proyectos       ProyectoCuenca[]

  @@index([distritoId])
  @@index([estado])
  @@index([region])
  @@map("cuencas")
}

model Subcuenca {
  id            String         @id
  cuencaId      String         @map("cuenca_id")
  codigo        String         @db.VarChar(20)
  nombre        String         @db.VarChar(150)
  areaKm2       Float?         @map("area_km2")
  estado        EstadoRegistro @default(active)
  observaciones String?        @db.Text
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  cuenca          Watershed           @relation(fields: [cuencaId], references: [id], onDelete: Restrict)
  rios            River[]
  quebradas       Quebrada[]
  puntosMonitoreo Station[]

  @@unique([cuencaId, codigo])
  @@index([cuencaId])
  @@map("subcuencas")
}

// =============================================================================
// 2. RÍO — Sprint 2A
// id · nombre · longitud · cuenca_id (+ metadatos cartográficos v2)
// =============================================================================

model River {
  id            String         @id
  codigo        String         @db.VarChar(20)
  cuencaId      String         @map("cuenca_id")
  subcuencaId   String?        @map("subcuenca_id")
  nombre        String         @db.VarChar(150)
  longitudKm    Float          @map("longitud_km")
  centroLat     Float          @map("centro_lat")
  centroLng     Float          @map("centro_lng")
  zoomMapa      Int            @default(12) @map("zoom_mapa")
  estado        EstadoRegistro @default(active)
  observaciones String?        @db.Text
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  cuenca          Watershed           @relation(fields: [cuencaId], references: [id], onDelete: Restrict)
  subcuenca       Subcuenca?       @relation(fields: [subcuencaId], references: [id], onDelete: SetNull)
  quebradas       Quebrada[]
  puntosMonitoreo Station[]
  campanas        Campaign[]
  reportes        Reporte[]
  proyectos       ProyectoRio[]

  @@unique([cuencaId, codigo])
  @@index([cuencaId])
  @@index([subcuencaId])
  @@map("rios")
}

model Quebrada {
  id            String         @id
  codigo        String         @db.VarChar(20)
  cuencaId      String         @map("cuenca_id")
  subcuencaId   String?        @map("subcuenca_id")
  rioId         String?        @map("rio_id")
  nombre        String         @db.VarChar(150)
  longitudKm    Float?         @map("longitud_km")
  latitude      Float?
  longitude     Float?
  estado        EstadoRegistro @default(active)
  observaciones String?        @db.Text
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  cuenca          Watershed           @relation(fields: [cuencaId], references: [id], onDelete: Restrict)
  subcuenca       Subcuenca?       @relation(fields: [subcuencaId], references: [id], onDelete: SetNull)
  rio             River?             @relation(fields: [rioId], references: [id], onDelete: SetNull)
  puntosMonitoreo Station[]

  @@unique([cuencaId, codigo])
  @@index([cuencaId])
  @@index([rioId])
  @@map("quebradas")
}

// =============================================================================
// PROYECTO — Soporte multi-proyecto ambiental
// =============================================================================

model Proyecto {
  id            String         @id
  codigo        String         @unique @db.VarChar(30)
  nombre        String         @db.VarChar(200)
  descripcion   String         @db.Text
  fechaInicio   DateTime       @map("fecha_inicio") @db.Date
  fechaFin      DateTime?      @map("fecha_fin") @db.Date
  estado        EstadoProyecto @default(active)
  observaciones String?        @db.Text
  responsableId String         @map("responsable_id")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  responsable        Usuario            @relation("ProyectoResponsable", fields: [responsableId], references: [id], onDelete: Restrict)
  cuencas            ProyectoCuenca[]
  rios               ProyectoRio[]
  campanas           Campaign[]
  reportes           Reporte[]
  indicesSatelitales SatelliteIndex[]
  imagenesSatelitales ImagenSatelital[]

  @@index([responsableId])
  @@index([estado])
  @@map("proyectos")
}

model ProyectoCuenca {
  proyectoId String @map("proyecto_id")
  cuencaId   String @map("cuenca_id")

  proyecto Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  cuenca   Watershed   @relation(fields: [cuencaId], references: [id], onDelete: Restrict)

  @@id([proyectoId, cuencaId])
  @@index([cuencaId])
  @@map("proyecto_cuencas")
}

model ProyectoRio {
  proyectoId String @map("proyecto_id")
  rioId      String @map("rio_id")

  proyecto Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  rio      River      @relation(fields: [rioId], references: [id], onDelete: Restrict)

  @@id([proyectoId, rioId])
  @@index([rioId])
  @@map("proyecto_rios")
}

// =============================================================================
// PUNTO DE MONITOREO — Estación de campo (compatibilidad UI: Estacion)
// =============================================================================

// =============================================================================
// 3. ESTACIÓN DE MONITOREO — Sprint 2A (tabla: estaciones)
// código · nombre · latitud · longitud · altitud · estado · río asociado
// =============================================================================

model Station {
  id                  String               @id
  codigo              String               @db.VarChar(10)
  /// Código oficial de registro (MINAM / ANA / entidad)
  codigoOficial       String?              @map("codigo_oficial") @db.VarChar(30)
  nombre              String               @db.VarChar(200)
  cuencaId            String               @map("cuenca_id")
  subcuencaId         String?              @map("subcuenca_id")
  rioId               String?              @map("rio_id")
  quebradaId          String?              @map("quebrada_id")
  departmentId        String               @map("departamento_id")
  provinceId          String               @map("provincia_id")
  districtId          String               @map("distrito_id")
  waterBodyTypeId     String?              @map("water_body_type_id")
  sensorTypeId        String?              @map("sensor_type_id")
  latitude            Float
  longitude           Float
  altitud             Float
  tipoCuerpoAgua      TipoCuerpoAgua       @default(river) @map("tipo_cuerpo_agua")
  tipoEstacion        TipoEstacion         @default(manual) @map("tipo_estacion")
  tramo               String               @db.VarChar(120)
  /// Entidad pública o institución responsable del monitoreo
  entidadResponsable  String?              @map("entidad_responsable") @db.VarChar(200)
  descripcion         String?              @db.Text
  fotografiaUrl       String?              @map("fotografia_url") @db.VarChar(500)
  fechaInstalacion    DateTime             @map("fecha_instalacion") @db.Date
  /// Estado operativo de la estación en campo
  estado              EstadoPuntoMonitoreo @default(active)
  estadoRegistro      EstadoRegistro       @default(active) @map("estado_registro")
  observaciones       String?              @db.Text
  ultimaActualizacion DateTime             @map("ultima_actualizacion")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")

  cuenca                Watershed                @relation(fields: [cuencaId], references: [id], onDelete: Restrict)
  subcuenca             Subcuenca?            @relation(fields: [subcuencaId], references: [id], onDelete: SetNull)
  rio                   River?                  @relation(fields: [rioId], references: [id], onDelete: Restrict)
  quebrada              Quebrada?             @relation(fields: [quebradaId], references: [id], onDelete: SetNull)
  department            Department          @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  province              Province             @relation(fields: [provinceId], references: [id], onDelete: Restrict)
  district              District              @relation(fields: [districtId], references: [id], onDelete: Restrict)
  waterBodyType         WaterBodyType?        @relation(fields: [waterBodyTypeId], references: [id], onDelete: SetNull)
  sensorType            SensorType?           @relation(fields: [sensorTypeId], references: [id], onDelete: SetNull)
  muestreos             Muestreo[]
  mediciones            Measurement[]
  indicesSatelitales    SatelliteIndex[]
  imagenesSatelitales   ImagenSatelital[]
  evaluacionesAmbiental EnvironmentalAssessment[]
  riesgosAmbientales    RiesgoAmbiental[]
  reportes              ReportePuntoMonitoreo[]

  @@unique([cuencaId, codigo])
  @@index([cuencaId])
  @@index([subcuencaId])
  @@index([departmentId])
  @@index([provinceId])
  @@index([districtId])
  @@index([waterBodyTypeId])
  @@index([sensorTypeId])
  @@index([estado])
  @@index([tipoEstacion])
  @@index([entidadResponsable])
  @@map("estaciones")
}

// =============================================================================
// CAMPAÑA Y MUESTREO
// =============================================================================

// =============================================================================
// 4. CAMPAÑA DE MONITOREO — Sprint 2A
// fecha · responsable · observaciones (+ metadatos operativos v2)
// =============================================================================

model Campaign {
  id            String        @id
  codigo        String        @unique @db.VarChar(20)
  nombre        String        @db.VarChar(200)
  proyectoId    String?       @map("proyecto_id")
  rioId         String        @map("rio_id")
  cuencaId      String        @map("cuenca_id")
  ecaStandardId String?       @map("eca_standard_id")
  fechaInicio   DateTime      @map("fecha_inicio") @db.Date
  fechaFin      DateTime      @map("fecha_fin") @db.Date
  responsableId String        @map("responsable_id")
  estado        EstadoCampana @default(planned)
  objetivo      String        @db.Text
  observaciones String?       @db.Text
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  proyecto    Proyecto?   @relation(fields: [proyectoId], references: [id], onDelete: SetNull)
  rio         River       @relation(fields: [rioId], references: [id], onDelete: Restrict)
  cuenca      Watershed   @relation(fields: [cuencaId], references: [id], onDelete: Restrict)
  ecaStandard EcaStandard? @relation(fields: [ecaStandardId], references: [id], onDelete: SetNull)
  responsable Usuario     @relation("CampanaResponsable", fields: [responsableId], references: [id], onDelete: Restrict)
  muestreos   Muestreo[]
  mediciones  Measurement[]

  @@index([proyectoId])
  @@index([rioId])
  @@index([ecaStandardId])
  @@index([estado])
  @@index([fechaInicio, fechaFin])
  @@map("campanas")
}

model Muestreo {
  id               String         @id
  campanaId        String         @map("campana_id")
  puntoMonitoreoId String         @map("estacion_id")
  codigoMuestra    String         @unique @map("codigo_muestra") @db.VarChar(50)
  fechaMuestreo    DateTime       @map("fecha_muestreo")
  responsableId    String         @map("responsable_id")
  clima            String         @db.VarChar(50)
  colorAparente    String         @map("color_aparente") @db.VarChar(50)
  estado           EstadoMuestreo @default(registered)
  observaciones    String?        @db.Text
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  campana        Campaign               @relation(fields: [campanaId], references: [id], onDelete: Restrict)
  puntoMonitoreo Station        @relation(fields: [puntoMonitoreoId], references: [id], onDelete: Restrict)
  responsable    Usuario               @relation("MuestreoResponsable", fields: [responsableId], references: [id], onDelete: Restrict)
  mediciones     Measurement[]
  evaluacion     EnvironmentalAssessment?
  riesgos        RiesgoAmbiental[]

  @@index([campanaId])
  @@index([puntoMonitoreoId])
  @@index([fechaMuestreo])
  @@index([estado])
  @@map("muestreos")
}

// =============================================================================
// PARÁMETRO · MEDICIÓN · NORMATIVA ECA
// =============================================================================

// =============================================================================
// 5. PARÁMETRO DE CALIDAD DEL AGUA — Sprint 2A
// Catálogo: pH, OD, Conductividad, Turbidez, Temperatura, DBO5, DQO,
//           Coliformes, Nitratos, Fosfatos (+ TDS, Caudal v2)
// =============================================================================

model Parameter {
  id            String              @id
  codigo        TipoParametroCodigo @unique
  nombre        String              @db.VarChar(120)
  unidad        String              @db.VarChar(30)
  categoryId    String?             @map("category_id")
  unitId        String?             @map("unit_id")
  descripcion   String?             @db.Text
  estado        EstadoRegistro      @default(active)
  observaciones String?             @db.Text
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  category   ParameterCategory?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  unit       MeasurementUnit?           @relation(fields: [unitId], references: [id], onDelete: SetNull)
  mediciones Measurement[]
  limites    EcaStandardParameterLimit[]

  @@index([categoryId])
  @@index([unitId])
  @@index([estado])
  @@map("parametros")
}

// =============================================================================
// 6. MEDICIÓN — Sprint 2A
// estación · campaña · parámetro · valor · unidad · cumplimiento ECA · comentario
// =============================================================================

model Measurement {
  id               String          @id
  muestreoId       String          @map("muestreo_id")
  campanaId        String?         @map("campana_id")
  parametroId      String          @map("parametro_id")
  puntoMonitoreoId String          @map("estacion_id")
  unitId           String?         @map("unit_id")
  valor            Float
  unidad           String          @db.VarChar(30)
  cumplimientoEca  EstadoECA?      @map("cumplimiento_eca")
  comentario       String?         @db.Text
  fechaMedicion    DateTime        @map("fecha_medicion")
  metodoAnalisis   String?         @map("metodo_analisis") @db.VarChar(120)
  laboratorio      String?         @db.VarChar(150)
  equipoUtilizado  String?         @map("equipo_utilizado") @db.VarChar(150)
  nivelConfianza   NivelConfianza? @map("nivel_confianza")
  responsableId    String?         @map("responsable_id")
  calidadDato      CalidadDato     @default(valid) @map("calidad_dato")
  estado           EstadoRegistro  @default(active)
  observaciones    String?         @db.Text
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  muestreo       Muestreo         @relation(fields: [muestreoId], references: [id], onDelete: Cascade)
  campana        Campaign?        @relation(fields: [campanaId], references: [id], onDelete: SetNull)
  parametro      Parameter        @relation(fields: [parametroId], references: [id], onDelete: Restrict)
  measurementUnit MeasurementUnit? @relation(fields: [unitId], references: [id], onDelete: SetNull)
  puntoMonitoreo Station          @relation(fields: [puntoMonitoreoId], references: [id], onDelete: Restrict)
  responsable    Usuario?         @relation("MedicionResponsable", fields: [responsableId], references: [id], onDelete: SetNull)

  @@unique([muestreoId, parametroId])
  @@index([puntoMonitoreoId])
  @@index([campanaId])
  @@index([parametroId])
  @@index([unitId])
  @@index([fechaMedicion])
  @@index([cumplimientoEca])
  @@index([nivelConfianza])
  @@index([laboratorio])
  @@map("mediciones")
}

// =============================================================================
// EVALUACIÓN AMBIENTAL — ECA + preparación IA
// =============================================================================

model EnvironmentalAssessment {
  id                  String       @id
  muestreoId          String       @unique @map("muestreo_id")
  puntoMonitoreoId    String       @map("estacion_id")
  normativaId         String?      @map("normativa_id")
  estado              EstadoECA
  scoreRiesgo         Float?       @map("score_riesgo")
  nivelAlerta         NivelAlerta? @map("nivel_alerta")
  parametrosViolados  Json         @default("[]") @map("parametros_violados")
  parametrosEnAlerta  Json         @default("[]") @map("parametros_en_alerta")
  normativaReferencia String       @map("normativa_referencia") @db.VarChar(255)
  evaluadoEn          DateTime     @map("evaluado_en")
  evaluadoPorId       String?      @map("evaluado_por_id")
  modelVersion        String?      @map("model_version") @db.VarChar(50)
  estadoRegistro      EstadoRegistro @default(active) @map("estado_registro")
  observaciones       String?      @db.Text
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")

  muestreo       Muestreo       @relation(fields: [muestreoId], references: [id], onDelete: Cascade)
  puntoMonitoreo Station @relation(fields: [puntoMonitoreoId], references: [id], onDelete: Restrict)
  normativa      EcaStandard?  @relation(fields: [normativaId], references: [id], onDelete: SetNull)
  evaluadoPor    Usuario?       @relation("EvaluacionEvaluador", fields: [evaluadoPorId], references: [id], onDelete: SetNull)
  riesgos        RiesgoAmbiental[]

  @@index([puntoMonitoreoId])
  @@index([normativaId])
  @@index([estado])
  @@map("evaluaciones_ambientales")
}

// =============================================================================
// SATÉLITE — Índices espectrales + imágenes Sentinel-2 (preparado GEE)
// =============================================================================

// =============================================================================
// 7. ÍNDICE SATELITAL — Sprint 2A
// NDWI · MNDWI · NDVI · NDTI · fecha · fuente · resolución
// =============================================================================

model SatelliteIndex {
  id                      String          @id
  puntoMonitoreoId        String          @map("estacion_id")
  proyectoId              String?         @map("proyecto_id")
  satelliteSourceId       String?         @map("satellite_source_id")
  fechaAdquisicion        DateTime        @map("fecha_adquisicion") @db.Date
  fuente                  FuenteSatelital
  resolucionMetros        Float           @default(10) @map("resolucion_m")
  ndwi                    Float
  ndvi                    Float
  mndwi                   Float
  ndti                    Float
  temperaturaSuperficial  Float?          @map("temperatura_superficial")
  coberturaVegetal        Float?          @map("cobertura_vegetal")
  coberturaNubosa         Float           @map("cobertura_nubosa")
  tileId                  String?         @map("tile_id") @db.VarChar(50)
  estado                  EstadoRegistro  @default(active)
  observaciones           String?         @db.Text
  createdAt               DateTime        @default(now()) @map("created_at")
  updatedAt               DateTime        @updatedAt @map("updated_at")

  puntoMonitoreo  Station          @relation(fields: [puntoMonitoreoId], references: [id], onDelete: Cascade)
  proyecto        Proyecto?        @relation(fields: [proyectoId], references: [id], onDelete: SetNull)
  satelliteSource SatelliteSource? @relation(fields: [satelliteSourceId], references: [id], onDelete: SetNull)
  imagenes        ImagenSatelital[]

  @@index([puntoMonitoreoId, fechaAdquisicion])
  @@index([proyectoId])
  @@index([satelliteSourceId])
  @@index([fuente])
  @@map("indices_satelitales")
}

model ImagenSatelital {
  id               String          @id
  indiceSatelitalId String?        @map("indice_satelital_id")
  puntoMonitoreoId String          @map("estacion_id")
  proyectoId       String?         @map("proyecto_id")
  fuente           FuenteSatelital @default(sentinel2)
  fechaAdquisicion DateTime        @map("fecha_adquisicion") @db.Date
  url              String          @db.VarChar(500)
  tileId           String?         @map("tile_id") @db.VarChar(50)
  bandas           Json?
  metadata         Json?
  estado           EstadoRegistro  @default(active)
  observaciones    String?         @db.Text
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  indiceSatelital SatelliteIndex? @relation(fields: [indiceSatelitalId], references: [id], onDelete: SetNull)
  puntoMonitoreo  Station   @relation(fields: [puntoMonitoreoId], references: [id], onDelete: Cascade)
  proyecto        Proyecto?        @relation(fields: [proyectoId], references: [id], onDelete: SetNull)

  @@index([puntoMonitoreoId])
  @@index([proyectoId])
  @@index([fuente])
  @@map("imagenes_satelitales")
}

// =============================================================================
// 8. RIESGO AMBIENTAL — Sprint 2A
// nivel · descripción · color · fecha (vinculado a estación y muestreo)
// =============================================================================

model RiesgoAmbiental {
  id               String       @id
  puntoMonitoreoId String       @map("estacion_id")
  muestreoId       String?      @map("muestreo_id")
  evaluacionId     String?      @map("evaluacion_id")
  /// Nivel de riesgo ambiental agregado
  nivel            NivelAlerta
  /// Descripción interpretativa del riesgo
  descripcion      String       @db.Text
  /// Color de visualización (hex, ej. #10b981)
  color            String       @db.VarChar(20)
  /// Fecha de registro del riesgo
  fecha            DateTime     @db.Date
  score            Float?
  estado           EstadoRegistro @default(active)
  observaciones    String?      @db.Text
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  puntoMonitoreo Station        @relation(fields: [puntoMonitoreoId], references: [id], onDelete: Cascade)
  muestreo       Muestreo?            @relation(fields: [muestreoId], references: [id], onDelete: SetNull)
  evaluacion     EnvironmentalAssessment? @relation(fields: [evaluacionId], references: [id], onDelete: SetNull)

  @@index([puntoMonitoreoId, fecha])
  @@index([muestreoId])
  @@index([nivel])
  @@map("riesgos_ambientales")
}

// =============================================================================
// USUARIO · REPORTE
// =============================================================================

model Usuario {
  id            String         @id
  nombre        String         @db.VarChar(150)
  email         String         @unique @db.VarChar(255)
  rol           RolUsuario     @default(viewer)
  institucion   String         @db.VarChar(200)
  activo        Boolean        @default(true)
  estado        EstadoRegistro @default(active)
  observaciones String?        @db.Text
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  proyectosResponsable   Proyecto[]            @relation("ProyectoResponsable")
  campanasResponsable    Campaign[]             @relation("CampanaResponsable")
  muestreosResponsable   Muestreo[]            @relation("MuestreoResponsable")
  medicionesResponsable  Measurement[]            @relation("MedicionResponsable")
  evaluacionesRealizadas EnvironmentalAssessment[] @relation("EvaluacionEvaluador")
  reportesGenerados      Reporte[]             @relation("ReporteGenerador")
  dataImports            DataImport[]
  reportExports          ReportExport[]
  auditLogs              AuditLog[]

  @@index([rol])
  @@index([estado])
  @@map("usuarios")
}

// =============================================================================
// ROLES Y PERMISOS — Sprint 3I (User = Usuario · tabla usuarios)
// =============================================================================

model Role {
  id          String           @id
  code        String           @unique @db.VarChar(40)
  name        String           @db.VarChar(120)
  description String?          @db.Text
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id
  code        String           @unique @db.VarChar(60)
  name        String           @db.VarChar(120)
  category    String?          @db.VarChar(60)
  description String?          @db.Text
  createdAt   DateTime         @default(now()) @map("created_at")

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Reporte {
  id            String        @id
  titulo        String        @db.VarChar(255)
  proyectoId    String?       @map("proyecto_id")
  rioId         String        @map("rio_id")
  cuencaId      String        @map("cuenca_id")
  fechaInicio   DateTime      @map("fecha_inicio") @db.Date
  fechaFin      DateTime      @map("fecha_fin") @db.Date
  generadoPorId String        @map("generado_por_id")
  estado        EstadoReporte @default(draft)
  resumen       String        @db.Text
  observaciones String?       @db.Text
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  proyecto    Proyecto?             @relation(fields: [proyectoId], references: [id], onDelete: SetNull)
  rio         River                   @relation(fields: [rioId], references: [id], onDelete: Restrict)
  cuenca      Watershed                @relation(fields: [cuencaId], references: [id], onDelete: Restrict)
  generadoPor Usuario               @relation("ReporteGenerador", fields: [generadoPorId], references: [id], onDelete: Restrict)
  puntos      ReportePuntoMonitoreo[]

  @@index([proyectoId])
  @@index([rioId])
  @@index([estado])
  @@map("reportes")
}

model ReportePuntoMonitoreo {
  reporteId          String @map("reporte_id")
  puntoMonitoreoId   String @map("estacion_id")

  reporte        Reporte        @relation(fields: [reporteId], references: [id], onDelete: Cascade)
  puntoMonitoreo Station @relation(fields: [puntoMonitoreoId], references: [id], onDelete: Restrict)

  @@id([reporteId, puntoMonitoreoId])
  @@map("reporte_estaciones")
}

// =============================================================================
// IMPORTACIÓN DE DATOS — Sprint 3F
// =============================================================================

enum DataImportStatus {
  pending    @map("pending")
  validated  @map("validated")
  completed  @map("completed")
  partial    @map("partial")
  failed     @map("failed")
}

model DataImport {
  id                String           @id
  fileName          String           @map("file_name") @db.VarChar(255)
  fileSize          Int              @map("file_size")
  mimeType          String?          @map("mime_type") @db.VarChar(120)
  responsableId     String           @map("responsable_id")
  responsableNombre String?          @map("responsable_nombre") @db.VarChar(150)
  totalRows         Int              @map("total_rows")
  validRows         Int              @default(0) @map("valid_rows")
  warningRows       Int              @default(0) @map("warning_rows")
  errorRows         Int              @default(0) @map("error_rows")
  importedRows      Int              @default(0) @map("imported_rows")
  rejectedRows      Int              @default(0) @map("rejected_rows")
  status            DataImportStatus @default(pending)
  columnMapping     Json?            @map("column_mapping")
  errorLog          Json?            @map("error_log")
  startedAt         DateTime         @default(now()) @map("started_at")
  completedAt       DateTime?        @map("completed_at")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  responsable Usuario @relation(fields: [responsableId], references: [id], onDelete: Restrict)

  @@index([status])
  @@index([startedAt])
  @@index([responsableId])
  @@map("data_imports")
}

enum ReportExportFormat {
  csv   @map("csv")
  xlsx  @map("xlsx")
  pdf   @map("pdf")
}

model ReportExport {
  id                String             @id
  fileFormat        ReportExportFormat @map("file_format")
  fileName          String             @map("file_name") @db.VarChar(255)
  responsableId     String             @map("responsable_id")
  responsableNombre String?            @map("responsable_nombre") @db.VarChar(150)
  filters           Json
  sections          Json?
  recordCount       Int                @map("record_count")
  createdAt         DateTime           @default(now()) @map("created_at")

  responsable Usuario @relation(fields: [responsableId], references: [id], onDelete: Restrict)

  @@index([createdAt])
  @@index([responsableId])
  @@map("report_exports")
}

// =============================================================================
// AUDITORÍA Y TRAZABILIDAD — Sprint 3H
// =============================================================================

enum AuditAction {
  CREATE @map("create")
  UPDATE @map("update")
  DELETE @map("delete")
  IMPORT @map("import")
  EXPORT @map("export")
}

model AuditLog {
  id                String      @id
  entityType        String      @map("entity_type") @db.VarChar(80)
  entityId          String      @map("entity_id") @db.VarChar(80)
  action            AuditAction
  timestamp         DateTime    @default(now())
  previousData      Json?       @map("previous_data")
  newData           Json?       @map("new_data")
  description       String?     @db.Text
  responsableId     String      @map("responsable_id")
  responsableNombre String?     @map("responsable_nombre") @db.VarChar(150)

  responsable Usuario @relation(fields: [responsableId], references: [id], onDelete: Restrict)

  @@index([entityType])
  @@index([entityId])
  @@index([action])
  @@index([timestamp])
  @@index([responsableId])
  @@map("audit_logs")
}
